rules_version = '2';

// قواعد أمان تعاونوا.
// المبدأ: التطبيق بيعدل تقدم المستخدم وبياناته الشخصية بس.
// إنشاء المجموعات، والانضمام، والدعوات، والتدوير، والنقاط: Cloud Functions بس
// (الـFunctions بتتخطى القواعد دي لأنها بتشتغل بصلاحيات السيرفر).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- دوال مساعدة ----------

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function memberPath(groupId, uid) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(uid);
    }

    function isMember(groupId) {
      return signedIn() && exists(memberPath(groupId, request.auth.uid));
    }

    function roleOf(groupId) {
      return get(memberPath(groupId, request.auth.uid)).data.role;
    }

    function isAdmin(groupId) {
      return isMember(groupId) && roleOf(groupId) == 'admin';
    }

    function isManager(groupId) {
      return isMember(groupId) && roleOf(groupId) in ['admin', 'assistant'];
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function isShortText(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    // ---------- المستخدمين ----------
    // الاسم والصورة والإعدادات يعدلهم صاحبهم.
    // النقاط والسلسلة والإحصائيات يكتبها السيرفر بس.

    // إعدادات التطبيق العامة (آخر نسخة وأقل نسخة مسموحة): الكل يقراها، ومحدش يكتبها من التطبيق.
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      // كل واحد يقرا ملفه بس. أسماء وصور الأعضاء موجودة في أعضاء كل مجموعة.
      allow read: if isSelf(uid);

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['name', 'photoUrl', 'locale', 'createdAt'])
        && isShortText(request.resource.data.name, 60)
        && request.resource.data.createdAt == request.time;

      allow update: if isSelf(uid)
        && changedOnly(['name', 'photoUrl', 'locale', 'settings', 'fcmTokens', 'notifSeenAt', 'appVersion', 'appPlatform', 'appVersionAt'])
        && (!('name' in request.resource.data) || isShortText(request.resource.data.name, 60))
        && (!('fcmTokens' in request.resource.data)
            || (request.resource.data.fcmTokens is list && request.resource.data.fcmTokens.size() <= 10))
        && (!('locale' in request.resource.data) || request.resource.data.locale in ['ar', 'en'])
        && (request.resource.data.get('notifSeenAt', null) == resource.data.get('notifSeenAt', null)
            || request.resource.data.notifSeenAt == request.time)
        && (!('appVersion' in request.resource.data) || isShortText(request.resource.data.appVersion, 20))
        && (!('appPlatform' in request.resource.data) || request.resource.data.appPlatform in ['android', 'ios'])
        && (request.resource.data.get('appVersionAt', null) == resource.data.get('appVersionAt', null)
            || request.resource.data.appVersionAt == request.time);

      // آخر آية وقف عندها في كل ختمة: خاص بصاحبه بس.
      // وقت التلاوة لكل يوم: خاص بصاحبه بس.
      match /private/{doc} {
        allow read: if isSelf(uid);
        allow write: if isSelf(uid) && doc == 'readingTime'
          && request.resource.data.keys().hasOnly(['days', 'at'])
          && request.resource.data.days is map
          && request.resource.data.at == request.time;
      }

      match /readPositions/{id} {
        allow read, delete: if isSelf(uid);
        allow write: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['key', 'pos', 'at'])
          && request.resource.data.key is string && request.resource.data.key.size() <= 160
          && request.resource.data.pos is string && request.resource.data.pos.size() <= 40
          && request.resource.data.at == request.time;
      }

      // الجرس: صاحب الحساب يقرا إشعاراته بس، والسيرفر بس اللي بيكتبها.
      match /notifications/{id} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      allow delete: if false;

      // فهرس "مجموعاتي": السيرفر بيكتبه، وصاحبه بس يقراه.
      match /groups/{groupId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // ---------- المجموعات ----------

    match /groups/{groupId} {
      // العامة يشوفها أي حد مسجّل، والخاصة أعضاءها بس.
      allow read: if signedIn()
        && (resource.data.type == 'public' || isMember(groupId));

      // الإنشاء والحذف عن طريق Cloud Functions.
      allow create, delete: if false;

      // كل التعديلات (الإعدادات، والأعضاء، والأدوار، والتقدم، والأوراد الإضافية)
      // بتعدي على Cloud Functions، عشان النقاط والفهارس تفضل متسقة.
      allow update: if false;

      match /members/{memberId} {
        allow read: if isMember(groupId);
        allow write: if false;
      }

      match /cycles/{cycleId} {
        allow read: if isMember(groupId);
        allow write: if false;

        match /assignments/{memberId} {
          allow read: if isMember(groupId);
          allow write: if false;
        }
      }

      // الأوراد الإضافية: متأخرة، أو موزعة، أو خانات فاضية متاحة للتطوع.
      match /portions/{portionId} {
        allow read: if isMember(groupId);
        allow write: if false;
      }

      match /khatmas/{khatmaId} {
        allow read: if isMember(groupId);
        allow write: if false;
      }
    }

    // ---------- الدعوات ----------
    // بتتعمل وبتتقري عن طريق Cloud Functions بس، عشان الأكواد متتسربش.
    match /invites/{code} {
      allow read, write: if false;
    }

    // أي حاجة تانية ممنوعة.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
